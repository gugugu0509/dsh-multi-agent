# 飞书 / Agent 标识配置示例
# 复制为 scripts/.env.local.cmd（cmd）或 scripts/.env.local.ps1（PowerShell）
# 这两个文件名已在 .gitignore 中，真实值不会入库。

# ── 飞书应用凭据（必填）─────────────────────────────
FA_ID=
FA_SECRET=

# ── 群里各方的标识 ──────────────────────────────────
# 主协作群 chat_id（oc_ 开头）
FS_CHAT_MAIN=
# 本 agent 自己的 app_id（cli_ 开头，用于跳过自己发的消息）
FS_SELF_APP=
# 另一个 agent 的 app_id（cli_ 开头）
FS_WBY_APP=
# 另一个 agent 机器人的 open_id（ou_ 开头，发 @ 用）
FS_WBY_OPEN=
# 人类的 open_id（ou_ 开头，识别 / @ 人类用）
FS_HUMAN_OPEN=
# 「茶脉」群 chat_id（只有茶脉相关脚本用得到）
FS_CHAT_TEAPULSE=

# ── 可选 ────────────────────────────────────────────
# 覆盖项目根路径（默认由 scripts/paths.mjs 按脚本位置推导）
DSH_PROJECT_DIR=
# 茶脉项目目录（供提示词引用）
TEA_PROJECT_DIR=
# 飞书 CLI（默认 lark-cli）；无 PATH 时可用 LARK_CLI_JS 指定 JS 入口
LARK_CLI=
LARK_CLI_JS=
# WorkBuddy CLI（默认 codebuddy）
WBY_CLI=
# 发消息草稿路径（默认 room/feishu-dsh-draft.txt）
FS_DRAFT=
# 设为 1 才允许重发与上次相同的草稿（默认拒绝，防重复刷群）
FS_ALLOW_STALE=
# 读消息条数（默认 1）
FS_N=
